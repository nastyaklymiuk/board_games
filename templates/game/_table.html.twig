<table>
    <tr><th>Назва</th><th>Категорія</th><th>Ціна</th><th>Гравці</th><th>Час</th><th>Наявність</th></tr>
    {% for game in games %}
        <tr>
            <td><a href="{{ path('app_game_show', {id: game.id}) }}">{{ game.title }}</a></td>
            <td><a href="{{ path('app_category_show', {id: game.category.id}) }}">{{ game.category.name }}</a></td>
            <td>{{ game.price }} грн</td>
            <td>{{ game.minPlayers }}–{{ game.maxPlayers }}</td>
            <td>{{ game.playTimeMinutes }} хв</td>
            <td>{% if game.inStock %}є{% else %}<span class="out">немає</span>{% endif %}</td>
        </tr>
    {% else %}
        <tr><td colspan="6">Нічого не знайдено</td></tr>
    {% endfor %}
</table>